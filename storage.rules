rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function perfil() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }
    function esAdmin() {
      return request.auth != null && perfil().activo == true && perfil().rol == 'admin';
    }
    function esTrabajador() {
      return request.auth != null && perfil().activo == true && perfil().rol == 'trabajador';
    }

    // Fotos de modelos y hormas: solo imágenes de hasta 5 MB, subidas por un admin.
    match /{carpeta}/{id}/{archivo} {
      allow read: if carpeta in ['modelos', 'hormas'] && (esAdmin() || esTrabajador());
      allow create, update: if carpeta in ['modelos', 'hormas'] && esAdmin()
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if carpeta in ['modelos', 'hormas'] && esAdmin();
    }
  }
}
